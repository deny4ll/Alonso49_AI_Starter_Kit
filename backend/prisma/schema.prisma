generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  ATHLETE
  COACH
  ACADEMY
  ADMIN
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum VideoType {
  VIDEO
  REPORT
}

enum TagLevel {
  SECTION
  SUBSECTION
}

enum KnowledgeCategory {
  methodology
  technique
  tactics
  boat_setup
  physical_prep
  mental_prep
}

enum KnowledgeDocumentStatus {
  PROCESSING
  READY
  FAILED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  avatar       String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  athleteProfile AthleteProfile?
  coachProfile   CoachProfile?
  academyProfile AcademyProfile?

  uploadedVideos            Video[]
  sessions                  Session[]
  teamMemberships           TeamMember[]
  courseEnrollments         CourseEnrollment[]
  givenFeedback             Feedback[]
  auditLogs                 AuditLog[]
  gpsTracks                 GpsTrack[]
  aiCoachSessions           AiCoachSession[]
  progressSummariesAuthored ProgressSummary[]
  uploadedKnowledgeDocuments KnowledgeDocument[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model AthleteProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Physical attributes
  weight    Float?
  height    Float?
  birthDate DateTime?

  // Sailing info
  sailNumber      String?
  position        String? // Helm, Crew, etc.
  experienceLevel String? // Beginner, Intermediate, Advanced, Elite
  nationality     String?

  // Team & Coaching
  teamId        String?
  team          Team?   @relation(fields: [teamId], references: [id])
  assignedCoach String?

  // Training Planning
  seasonGoal        String?
  currentMicrocycle String?
  weeklyObjectives  String?
  todayObjective    String?
  kpis              Json?

  // Competition
  nextEvent String?

  // Equipment
  boatSetup String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("athlete_profiles")
}

model CoachProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  certification   String?
  yearsExperience Int?
  specialties     String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teams            Team[]
  assignedSessions Session[]

  @@map("coach_profiles")
}

model AcademyProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  country   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams   Team[]
  courses Course[]

  @@map("academy_profiles")
}

model Team {
  id          String          @id @default(uuid())
  name        String
  description String?
  coachId     String?
  coach       CoachProfile?   @relation(fields: [coachId], references: [id])
  academyId   String?
  academy     AcademyProfile? @relation(fields: [academyId], references: [id])
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  members           TeamMember[]
  athletes          AthleteProfile[]
  sessions          Session[]
  videos            Video[]
  gpsTracks         GpsTrack[]
  benchmarks        TeamBenchmark[]
  progressSummaries ProgressSummary[]

  @@index([coachId])
  @@index([academyId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_members")
}

model Session {
  id                String        @id @default(uuid())
  title             String
  description       String?
  status            SessionStatus @default(DRAFT)
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  location          String?
  weatherConditions Json?
  windSpeed         Float?
  windDirection     String?
  waveHeight        Float?
  createdById       String
  createdBy         User          @relation(fields: [createdById], references: [id])
  teamId            String?
  team              Team?         @relation(fields: [teamId], references: [id])
  coachId           String?
  coach             CoachProfile? @relation(fields: [coachId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  videos    Video[]
  feedback  Feedback[]
  analytics SessionAnalytics?
  gpsTracks GpsTrack[]

  @@index([createdById])
  @@index([teamId])
  @@index([status])
  @@map("sessions")
}

model Video {
  id           String      @id @default(uuid())
  type         VideoType   @default(VIDEO)
  title        String
  description  String?
  // Opcional: un registro de tipo REPORT (informe de texto) no tiene archivo adjunto.
  url          String?
  thumbnailUrl String?
  duration     Int?
  size         Int?
  format       String?
  status       VideoStatus @default(UPLOADING)

  // Feedback (manual o generado por el AI Coach) sobre qué estuvo bien y qué es mejorable.
  feedback String?

  // Denormalizado desde Session para poder filtrar/buscar (viento, sitio, fecha)
  // aun cuando el video/informe no está vinculado a una sesión.
  location   String?
  windSpeed  Float?
  waveHeight Float?
  recordedAt DateTime?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  sessionId    String?
  session      Session? @relation(fields: [sessionId], references: [id])
  // Denormalizado desde el equipo del autor al momento de crear el registro,
  // para poder agregar el progreso por equipo sin tener que pasar por Session.
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])

  tags VideoTag[]

  metadata  Json?
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  deletedAt DateTime?

  @@index([uploadedById])
  @@index([sessionId])
  @@index([teamId])
  @@index([status])
  @@index([type])
  @@index([recordedAt])
  @@map("videos")
}

// Documento fuente (PDF/DOCX) subido por un admin/coach para alimentar la Knowledge
// Base del AI Coach. El texto se trocea y embebe en KnowledgeChunk para búsqueda
// semántica (ver searchKnowledgeBase en ai-coach/tools/tool-implementations.ts).
model KnowledgeDocument {
  id             String                  @id @default(uuid())
  title          String
  category       KnowledgeCategory
  sourceFileName String
  sourceUrl      String
  status         KnowledgeDocumentStatus @default(PROCESSING)
  errorMessage   String?
  uploadedById   String
  uploadedBy     User                    @relation(fields: [uploadedById], references: [id])
  chunks         KnowledgeChunk[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([category])
  @@index([uploadedById])
  @@map("knowledge_documents")
}

// Fragmento de texto de un KnowledgeDocument con su embedding para búsqueda por
// similitud coseno (pgvector). Mismo patrón que Video.embedding más arriba.
model KnowledgeChunk {
  id         String                       @id @default(uuid())
  documentId String
  document   KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@index([documentId])
  @@map("knowledge_chunks")
}

// Taxonomía Alonso49 de secciones/subsecciones (Team Set Up, Boat Handling, etc.).
// Jerarquía fija de 2 niveles, poblada por seed (ver prisma/seed-progress-tags.ts).
model Tag {
  id        String     @id @default(uuid())
  key       String     @unique
  label     String
  level     TagLevel
  order     Int        @default(0)
  parentId  String?
  parent    Tag?       @relation("TagHierarchy", fields: [parentId], references: [id])
  children  Tag[]      @relation("TagHierarchy")
  videos    VideoTag[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
  @@index([level])
  @@map("tags")
}

// Etiquetado de un Video/Informe con una o más secciones/subsecciones de la
// metodología. El progreso por área se calcula agregando estos registros.
model VideoTag {
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id])
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id])
  createdAt DateTime @default(now())

  @@id([videoId, tagId])
  @@index([tagId])
  @@map("video_tags")
}

// Resumen cualitativo editable ("Big Picture") del progreso de un equipo a la fecha.
model ProgressSummary {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  content     String
  updatedById String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teamId])
  @@map("progress_summaries")
}

// Valores de referencia ("equipo target AI") contra los que se compara el
// rendimiento real del equipo en la sección de Estadísticas.
model TeamBenchmark {
  id                  String   @id @default(uuid())
  teamId              String?
  team                Team?    @relation(fields: [teamId], references: [id])
  label               String   @default("Equipo Target AI")
  averageSpeed        Float?
  maxSpeed            Float?
  tackingEfficiency   Float?
  performanceScore    Float?
  daysOnWaterPerMonth Float?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([teamId])
  @@map("team_benchmarks")
}

// Track GPS/sensor subido por el usuario (archivo GPX/CSV parseado). Los puntos
// se guardan como Json (no como filas individuales) para mantener el modelo liviano;
// alcanza para dibujar el recorrido en un mapa y calcular métricas resumen.
model GpsTrack {
  id               String    @id @default(uuid())
  sessionId        String?
  session          Session?  @relation(fields: [sessionId], references: [id])
  uploadedById     String
  uploadedBy       User      @relation(fields: [uploadedById], references: [id])
  // Denormalizado desde Session o desde el equipo del uploader al crear el
  // registro, igual que en Video, para poder listar/filtrar por tripulación.
  teamId           String?
  team             Team?     @relation(fields: [teamId], references: [id])
  source           String?
  originalFileName String?
  // Array de puntos: [{ lat, lng, timestamp, speed? }, ...]
  points           Json
  distanceMeters   Float?
  durationSeconds  Int?
  averageSpeed     Float?
  maxSpeed         Float?
  startedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([sessionId])
  @@index([uploadedById])
  @@index([teamId])
  @@map("gps_tracks")
}

// Agrupa los turnos de chat del AI Coach en "sesiones de uso" para poder calcular
// horas dedicadas a la plataforma (Módulo de Estadísticas). Se abre/actualiza en
// cada llamada a chat(); una nueva sesión arranca si pasaron más de 30 min de inactividad.
model AiCoachSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  messageCount   Int      @default(0)

  @@index([userId])
  @@index([lastActivityAt])
  @@map("ai_coach_sessions")
}

model Feedback {
  id        String   @id @default(uuid())
  content   String
  rating    Int?
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id])
  coachId   String
  coach     User     @relation(fields: [coachId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([coachId])
  @@map("feedback")
}

model SessionAnalytics {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  session           Session  @relation(fields: [sessionId], references: [id])
  totalDistance     Float?
  averageSpeed      Float?
  maxSpeed          Float?
  tackingEfficiency Float?
  gybeCount         Int?
  tackCount         Int?
  performanceScore  Float?
  insights          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("session_analytics")
}

model Course {
  id          String          @id @default(uuid())
  title       String
  description String?
  price       Float           @default(0)
  currency    String          @default("USD")
  isPublished Boolean         @default(false)
  academyId   String?
  academy     AcademyProfile? @relation(fields: [academyId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  modules     CourseModule[]
  enrollments CourseEnrollment[]

  @@index([academyId])
  @@index([isPublished])
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String?
  order       Int
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@map("course_modules")
}

model CourseEnrollment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  progress    Float     @default(0)
  completedAt DateTime?
  enrolledAt  DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_enrollments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
