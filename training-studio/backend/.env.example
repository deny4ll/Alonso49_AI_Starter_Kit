# Base de datos PROPIA del Training Studio (nunca la de la plataforma principal)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/training_studio?schema=public

# Auth independiente
JWT_SECRET=change-me-training-studio-secret
JWT_EXPIRATION=7d

PORT=3002
FRONTEND_URL=http://localhost:3003

# OpenAI, usado para embeddings y para el chat de prueba/corrección
OPENAI_API_KEY=

# Almacenamiento de documentos subidos (Supabase Storage). Puede apuntar al
# mismo proyecto Supabase de la plataforma o a uno distinto: es solo
# configuración de un servicio externo, no una conexión en tiempo de
# ejecución con el backend principal.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=training-documents

# --- Solo usado por `npm run sync:platform` (nunca por la app en runtime) ---
# Cadena de conexión de solo-este-script hacia la base de datos de la
# plataforma principal (alonso49), para insertar el contenido aprobado en
# knowledge_documents / knowledge_chunks.
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alonso49?schema=public

# Id de un User existente en la plataforma (ej. un ADMIN) al que se le
# atribuyen los documentos sincronizados (knowledge_documents.uploadedById
# es obligatorio allí). Consultar con: SELECT id FROM users WHERE role='ADMIN' LIMIT 1;
PLATFORM_SYNC_USER_ID=
